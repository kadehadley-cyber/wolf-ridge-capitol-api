{
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"name": "wolf-ridge-capitol-api",
	"upload_source_maps": true,
	"assets": {
		"directory": "./web",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "www.cellsunova.com", "custom_domain": true },
		{ "pattern": "cellsunova.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "f3b36f53-dda4-40e5-be1f-f751a225dcf5",
			"database_name": "d1-template-database"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"JARVIS_HOME_LOCATION": "St. George, Utah",
		"JARVIS_TIMEZONE": "America/Denver"
	},
	"observability": {
		"enabled": true
	}
}
