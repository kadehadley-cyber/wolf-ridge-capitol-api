#!/usr/bin/env bash
# Jarvis Desktop launcher (macOS / Linux). Creates a venv on first run,
# installs dependencies, then starts the app. Arguments pass through.
set -euo pipefail
cd "$(dirname "$0")"

# This launcher only works next to its app files; a lone copy lands here.
if [ ! -f jarvis_desktop.py ] || [ ! -f requirements.txt ]; then
	echo "This launcher must stay in the repo's desktop folder, next to" >&2
	echo "jarvis_desktop.py and requirements.txt — this copy is on its own." >&2
	echo "Run it from inside the project folder (make an alias/shortcut instead of copying)." >&2
	exit 1
fi

PY="${PYTHON:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
	echo "Python 3 is required. Install it and re-run." >&2
	exit 1
fi

# The stamp file is written only after a *successful* install, so a half-done
# first run (network hiccup mid-pip) retries instead of wedging forever.
if [ ! -f .venv/.deps-ok ]; then
	if [ ! -d .venv ]; then
		echo "Creating virtual environment (first run only)…"
		"$PY" -m venv .venv
	fi
	./.venv/bin/pip install --upgrade pip >/dev/null
	echo "Installing dependencies (this takes a minute)…"
	./.venv/bin/pip install -r requirements.txt
	touch .venv/.deps-ok
fi

exec ./.venv/bin/python jarvis_desktop.py "$@"
