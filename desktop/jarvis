#!/usr/bin/env bash
# Jarvis Desktop launcher (macOS / Linux). Creates a venv on first run,
# installs dependencies, then starts the app. Arguments pass through.
set -euo pipefail
cd "$(dirname "$0")"

PY="${PYTHON:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
	echo "Python 3 is required. Install it and re-run." >&2
	exit 1
fi

if [ ! -d .venv ]; then
	echo "Creating virtual environment (first run only)…"
	"$PY" -m venv .venv
	./.venv/bin/pip install --upgrade pip >/dev/null
	echo "Installing dependencies (this takes a minute)…"
	./.venv/bin/pip install -r requirements.txt
fi

exec ./.venv/bin/python jarvis_desktop.py "$@"
